<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment. "development" is used for debug builds; Xcode/fastlane
	     rewrites this to "production" for App Store / TestFlight archives.
	     Getting this wrong is the classic cause of "push works in debug, silent
	     on TestFlight". -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
